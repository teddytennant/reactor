# Copy to .env and fill in. Never commit .env. Keys stay host-side and are
# stripped from every artifact process (internal/procenv).
#
# Public UI (reactor.teddytennant.com): visitors can also paste Daytona +
# Fireworks keys in the browser onboarding modal. Those ride on each
# /api/detonate as `credentials` and never land in Vercel env or git.

# --- disposable sandbox (optional; local driver is the default) ---
DAYTONA_API_KEY=
DAYTONA_API_URL=
# REACTOR_DRIVER=daytona   # route detonations into a live Daytona sandbox

# --- models: provider-agnostic OpenAI-compatible; this build uses Fireworks ---
FIREWORKS_API_KEY=
# Victim: the sacrificial agent that eats the poison — cheap, tool-call capable.
VICTIM_MODEL=accounts/fireworks/models/gpt-oss-120b
# Analyst: reasons over typed evidence and writes the verdict — needs tool calling.
ANALYST_MODEL=accounts/fireworks/models/kimi-k2p6
REACTOR_VICTIM_BACKEND=fireworks

# --- web UI (Vercel) ---
# NEXT_PUBLIC_ENGINE_URL=https://engine.example.com   # no trailing slash
# NEXT_PUBLIC_SITE_URL=https://reactor.teddytennant.com

# Alternatives:
#   XAI_API_KEY=...                         # victim/analyst on Grok (SPEC default)
#   REACTOR_VICTIM_BACKEND=sim              # deterministic, no external model
#   REACTOR_ANALYST=deterministic           # offline analyst (verdicts fallback:true)
#   REACTOR_VICTIM_BACKEND=sglang           # spec-pure Qwen3.6-27B in a GPU chamber
