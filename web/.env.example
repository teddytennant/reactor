# Vercel / local Next.js. Copy to web/.env.local for local overrides.
# Never commit real keys here — visitor BYOK lives in the browser only.

# Public origin of the Go engine (no trailing slash). Required on Vercel so the
# browser talks to the engine directly (SSE + long detonations). Locally you can
# leave this unset and use next.config.mjs rewrites to 127.0.0.1:8787.
# NEXT_PUBLIC_ENGINE_URL=https://engine.example.com

# Canonical site URL for metadata (OG, canonical links).
NEXT_PUBLIC_SITE_URL=https://reactor.teddytennant.com
